    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(demos|hotbite|burger-garage|frenchyse|anzaar|hq-leathercon)/(.+)",
      "headers": [
        {
          "key": "Cache-Control",
