<script>
(function () {
  var pin = document.querySelector('.hero-pin-pd');
  var inner = pin && pin.querySelector('.hero-pin-inner-pd');
  if (!inner) return;
  var phone = inner.querySelector('.phone-hero-cs, .phones-hero-boh-cs');
  var footer = null; // comes later in the page than this embed, so it is looked up in measure()

  var SPEED = 0.08; // share of scroll speed the pinned hero keeps
  var PHONE = 0.22; // extra share for the phone, on top of SPEED (phone moves at 30% of scroll speed)
  var desktop = window.matchMedia('(min-width: 992px) and (hover: hover) and (pointer: fine)');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var doc = document.documentElement;
  var H = 0, OFF = 0, FH = 0, on = false;

  function measure() {
    H = pin.offsetHeight;
    OFF = H - window.innerHeight;
    if (OFF < 0) OFF = 0;
    if (!footer) footer = document.querySelector('.section-footer-pd');
    FH = footer ? footer.offsetHeight : 0;
  }

  // Runs straight from the scroll event (no rAF): a one-frame delay would show as jitter,
  // because the blocks are being held almost still against the page scroll.
  function apply() {
    if (!on) return;
    var s = window.scrollY;

    var y = s < 0 ? 0 : s > H ? H : s;
    // A hero taller than the screen scrolls normally until its bottom edge reaches the bottom
    // of the screen (so the phone is fully shown first), and only then is held.
    var p = y - OFF;
    if (p < 0) p = 0;
    inner.style.transform = 'translate3d(0,' + (p * (1 - SPEED)).toFixed(2) + 'px,0)';
    if (phone) phone.style.transform = 'translate3d(0,' + (-y * PHONE).toFixed(2) + 'px,0)';

    if (footer) {
      // Distance left to the end of the page, capped at the footer's height.
      var r = doc.scrollHeight - window.innerHeight - s;
      r = r < 0 ? 0 : r > FH ? FH : r;
      footer.style.transform = r ? 'translate3d(0,' + (-r * (1 - SPEED)).toFixed(2) + 'px,0)' : '';
    }
  }

  function sync() {
    var want = desktop.matches && !reduce.matches;
    if (want) {
      on = true;
      measure();
      inner.style.willChange = 'transform';
      if (phone) phone.style.willChange = 'transform';
      apply();
    } else if (on) {
      on = false;
      inner.style.transform = '';
      inner.style.willChange = '';
      if (phone) { phone.style.transform = ''; phone.style.willChange = ''; }
      if (footer) footer.style.transform = '';
    }
  }

  window.addEventListener('scroll', apply, { passive: true });
  window.addEventListener('resize', sync);
  document.addEventListener('DOMContentLoaded', sync);
  window.addEventListener('load', sync);
  if (desktop.addEventListener) {
    desktop.addEventListener('change', sync);
    reduce.addEventListener('change', sync);
  }
  sync();
