<script>
// ---- FIX: страховка на случай, если этот <style> физически подключается
// в Footer (после того как Webflow уже успел отрисовать .navbar своими
// дефолтными стилями). В таком случае наш CSS-переход "top 0.4s ease"
// срабатывает не как первичное применение стиля, а как ОБЫЧНОЕ изменение
// уже отрисованного элемента — и браузер честно его анимирует, отсюда
// видимый выезд сверху вниз при загрузке.
// Отслеживаем появление .navbar в DOM максимально рано и сразу глушим
// transition, пока элемент ещё не покрашен с анимацией.
(function () {
  function killTransition(el) {
    if (!el || el.__transitionKilled) return;
    el.__transitionKilled = true;
    el.style.setProperty('transition', 'none', 'important');
    void el.offsetHeight;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        el.style.removeProperty('transition');
      });
    });
  }

  var existing = document.querySelector('.navbar');
  if (existing) { killTransition(existing); return; }

  var observer = new MutationObserver(function () {
    var el = document.querySelector('.navbar');
    if (el) {
      killTransition(el);
      observer.disconnect();
    }
  });
  observer.observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const navbar = document.querySelector('.navbar');
  // Dark sections: legacy class list + any element opted in via data-nav="dark" (used by new service pages)
  const darkSections = document.querySelectorAll('.section-case, .section-services, .section-founder, .section-parallax, .section-footer, [data-nav="dark"]');
  
  let lastScrollY = window.scrollY;
  
  function checkNavbarPosition() {
    const currentScrollY = window.scrollY;
    const navbarRect = navbar.getBoundingClientRect();
    const navbarCenter = navbarRect.top + (navbarRect.height / 2);
    
    // Перевірка скролу для зміни top (тільки для десктопу)
    if (window.innerWidth > 920) {
      if (currentScrollY > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    }
    
    let isInDarkSection = false;
    
    darkSections.forEach(section => {
      const sectionRect = section.getBoundingClientRect();
      
      // Перевіряємо чи центр навбару знаходиться в межах секції
      if (navbarCenter >= sectionRect.top && navbarCenter <= sectionRect.bottom) {
        isInDarkSection = true;
      }
    });
    
    // Додаємо або видаляємо клас dark-mode
    if (isInDarkSection) {
      navbar.classList.add('dark-mode');
    } else {
      navbar.classList.remove('dark-mode');
    }
    
    lastScrollY = currentScrollY;
  }
  
  // Початкова перевірка — без анімації, щоб при завантаженні сторінки
  // navbar одразу стояв на потрібній позиції, не "виїжджаючи".
  // Далі transition повертається, і скрол лишається плавним.
  navbar.style.setProperty('transition', 'none', 'important');
  checkNavbarPosition();
  void navbar.offsetHeight;
  navbar.style.removeProperty('transition');
  
  // Перевірка при скролі
  window.addEventListener('scroll', checkNavbarPosition);
});
